<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The link with Halo: only apps signed with the same key (Halo) can use it. -->
    <permission
        android:name="com.lonerxone.halo.permission.LINK"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.lonerxone.halo.permission.LINK" />

    <!-- Weather (Open-Meteo) and in-app updates from GitHub -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Use my location" for the weather; approximate only -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Swipe down for Android's notification shade (when not using Halo's) -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Widgets: steps (physical activity), today's events (calendar), screen time (usage access) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Liquid Glass: set your background as the phone wallpaper, and read the
         wallpaper so the glass can bend it (Android 13+ only shares it with
         "All files access"; Halo Launcher reads nothing else). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- The Timer widget asks your clock app to run the countdown. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <queries>
        <!-- Icon packs (the standard Nova / ADW / Lawnchair formats) -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="org.adw.ActivityStarter.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.dlto.atom.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="app.lawnchair.icons.THEMED_ICON" />
        </intent>
        <package android:name="com.lonerxone.halo" />
        <provider android:authorities="com.android.calendar" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Launcher.Base"
        tools:ignore="UnusedAttribute">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:screenOrientation="nosensor"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Launcher.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Halo Launcher settings"
            android:taskAffinity="com.lonerxone.halo.launcher.settings" />

        <activity
            android:name=".PickAppsActivity"
            android:exported="false"
            android:taskAffinity="com.lonerxone.halo.launcher.settings" />

        <activity
            android:name=".WallpaperActivity"
            android:exported="false"
            android:label="Wallpapers"
            android:windowSoftInputMode="adjustResize"
            android:taskAffinity="com.lonerxone.halo.launcher.settings" />

        <activity
            android:name=".WidgetPickActivity"
            android:exported="false" />

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
